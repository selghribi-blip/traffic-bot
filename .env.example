# Traffic Bot Configuration
# Copy this file to .env and fill in your values

# Zyte API (Scrapy Cloud) - Get from https://app.zyte.com/
ZYTE_API_KEY=df1f9a1329c047cf81a7c0ddace8f8cb

# MongoDB Atlas - Get from https://cloud.mongodb.com/
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://selghribi_db_user:M138350896m@@selghribi.gg77uxs.mongodb.net/traffic_bot?retryWrites=true&w=majority

# BrowserStack - Get from https://www.browserstack.com/accounts/settings
BROWSERSTACK_USERNAME=selghribiblip_JBub6m
BROWSERSTACK_ACCESS_KEY=xzfozgGiQMzUJPVULyah

# Target URL to crawl
TARGET_URL=https://www.forjo.tech/

# Free Proxy List URL (optional - uses built-in sources if not set)
FREE_PROXY_LIST_URL=https://raw.githubusercontent.com/xyzs996/free-proxy-health-list/main/proxies/all/data.txt

# Scrapy Settings
LOG_LEVEL=INFO
DOWNLOAD_DELAY=3
CONCURRENT_REQUESTS=2

# BrowserStack Settings
BROWSERSTACK_BROWSER=chrome
BROWSERSTACK_OS=Windows
BROWSERSTACK_OS_VERSION=11
BROWSERSTACK_LOCAL=false

# Run Mode: scrapy, browserstack, local, or both
RUN_MODE=both

# Session Settings
MAX_PAGES_PER_RUN=20
MAX_ADS_PER_RUN=50
MAX_FORMS_PER_RUN=10